{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UI/UX request contract",
  "description": "Versioned machine-readable request shape used by ui-ux-router case manifests. Governs design tokens, component variants, viewports, and WCAG accessibility standards.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "version",
    "operation",
    "design_system_profile",
    "target_viewports",
    "intent",
    "representations",
    "constraints",
    "references",
    "accessibility_standards",
    "audience_delivery",
    "provenance",
    "open_questions",
    "review_handoff"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "request_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "operation": {
      "enum": [
        "design_token_compile",
        "component_variant_matrix",
        "visual_regression_audit",
        "wcag_accessibility_audit",
        "responsive_breakpoint_verify",
        "micro_interaction_spec"
      ]
    },
    "design_system_profile": {
      "type": "object",
      "required": ["system_id", "token_format", "color_spaces"],
      "properties": {
        "system_id": {"type": "string"},
        "token_format": {"enum": ["dtcg_2025_10", "style_dictionary_v4", "tailwind_v4"]},
        "color_spaces": {"type": "array", "items": {"enum": ["srgb", "display_p3", "oklch"]}},
        "theme_modes": {"type": "array", "items": {"enum": ["light", "dark", "high_contrast"]}}
      },
      "additionalProperties": true
    },
    "target_viewports": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "enum": [375, 768, 1024, 1280, 1440, 1920]}
    },
    "intent": {
      "type": "object",
      "required": ["primary_objective", "user_interaction_flow"],
      "properties": {
        "primary_objective": {"type": "string", "minLength": 1},
        "user_interaction_flow": {"type": "string", "minLength": 1},
        "preserve_tokens": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "representations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {"$ref": "#/$defs/representation"}
    },
    "constraints": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/constraint"}
    },
    "references": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "object", "additionalProperties": true}
    },
    "accessibility_standards": {
      "type": "object",
      "required": [
        "wcag_target_level",
        "min_touch_target_px",
        "min_text_contrast_ratio",
        "keyboard_focusable_only",
        "reduced_motion_supported"
      ],
      "properties": {
        "wcag_target_level": {"enum": ["A", "AA", "AAA"]},
        "min_touch_target_px": {"type": "integer", "minimum": 24},
        "min_text_contrast_ratio": {"type": "number", "minimum": 3.0},
        "keyboard_focusable_only": {"type": "boolean"},
        "reduced_motion_supported": {"type": "boolean"}
      },
      "additionalProperties": true
    },
    "audience_delivery": {
      "type": "object",
      "required": ["recipient_role", "delivery_format"],
      "properties": {
        "recipient_role": {"type": "string", "minLength": 1},
        "delivery_format": {"enum": ["html", "css", "json", "markdown", "png_golden"]}
      },
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "required": ["model_tier", "timestamp_utc"],
      "properties": {
        "model_tier": {"type": "string"},
        "timestamp_utc": {"type": "string"}
      },
      "additionalProperties": true
    },
    "open_questions": {
      "type": "array",
      "maxItems": 100,
      "items": {"type": "string"}
    },
    "review_handoff": {
      "type": "object",
      "required": ["owner", "reviewer", "acceptance_tests"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "reviewer": {"type": "string", "minLength": 1},
        "acceptance_tests": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "accessibility_gate_passed": {"type": "boolean"}
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "route", "asset", "role", "delivery"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "route": {"type": "string", "minLength": 1},
        "asset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {"type": "string", "minLength": 1}
          }
        },
        "role": {"enum": ["primary", "supporting"]},
        "delivery": {
          "type": "object",
          "required": ["intended_use", "format"],
          "properties": {
            "intended_use": {"type": "string", "minLength": 1},
            "format": {"type": "string", "minLength": 1}
          },
          "additionalProperties": true
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "source", "status", "hardness"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "source": {"enum": ["wcag", "design_tokens", "system_contract", "agent_default"]},
        "status": {"enum": ["required", "preferred", "open", "blocked"]},
        "hardness": {"enum": ["hard", "soft"]}
      }
    }
  }
}
